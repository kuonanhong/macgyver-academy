# Copy to .env for the portable Python server. Never commit the real .env.
# Use a /v1 base URL. Hosted runtime values are configured as server-side secrets.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional same-computer Ollama routes (do not expose Ollama to the Internet).
# Models must already be installed, or use run-ai-local.sh --download explicitly.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_TEXT_MODEL=qwen3:4b
# OLLAMA_VISION_MODEL=qwen3-vl:2b
# Optional Gemini route. Store the real key only in private .env / server secrets.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Portable default starts at http://127.0.0.1:8010 (automatic free port selection).
# Keep SITE_ORIGIN unset for automatic local port selection.
# AI_TIMEOUT_SECONDS=180
# Internet hosting requires HTTPS reverse proxy + exact public origin:
# SITE_ORIGIN=https://academy.example.org
# A local OpenAI-compatible model server may use:
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_API_KEY=local
# AI_MODEL=your-installed-model-name
# Optional V10 overseas market data: server-only licensed display feed.
# Taiwan daily closing data works without this key.
MARKET_DATA_API_KEY=
MARKET_DATA_LICENSE_ACK=false
# Paid curriculum deployment has separate merchant and legal configuration.
# Copy only needed values from examples/commerce.env.example into private .env.
COMMERCE_MODE=demo
BILLING_MODE=disabled

# Native Anthropic Messages API; choose a model available to your API account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
