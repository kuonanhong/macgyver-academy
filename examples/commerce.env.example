# Copy the needed values into the private root .env, NOT public/config.js.
# Default protects paid lessons while leaving checkout disabled.
COMMERCE_MODE=protected
BILLING_MODE=disabled
SITE_ORIGIN=https://academy.example.org
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# For a separate test deployment only, use BILLING_MODE=sandbox and the public
# TEST credentials from https://developers.ecpay.com.tw/2856/.
# Never put real card information into the sandbox or into this application.
# Live requires your own approved merchant credentials and both explicit flags.
# ECPAY_LIVE_CONFIRMED=1
# COMMERCE_LEGAL_READY=1
# Do not set these until the merchant is approved, HTTPS/webhook/access-control
# deployment tests pass, terms/privacy/refunds/support are finalized, and a real
# low-value payment + refund + reconciliation has been tested by the owner.
