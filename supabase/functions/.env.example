# MacGyver Academy V12 payment functions: secrets template.
# Copy to supabase/functions/.env (git-ignored), fill in, then:
#   supabase secrets set --env-file supabase/functions/.env
# Never commit the real .env. Never put these values in public/academy/config.js.
# No bank or post-office account number belongs here: payouts are configured
# only inside the PayPal and ECPay dashboards.

# --- Provided automatically by Supabase on hosted Edge Functions -------------
# (`supabase secrets set` skips names starting with SUPABASE_; keep them only for
#  local `supabase functions serve`.)
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_or_legacy_anon_key
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_legacy_service_role_key

# --- Website ------------------------------------------------------------------
# Browser origins allowed to call the functions (scheme + host only, comma-separated).
ALLOWED_ORIGINS=https://kuonanhong.github.io
# Public academy URL (used for the ECPay "back to shop" link).
SITE_URL=https://kuonanhong.github.io/macgyver-academy/
# Must equal the termsVersion the checkout page sends after the buyer accepts the terms.
TERMS_VERSION=v12-2026-10

# --- PayPal (developer.paypal.com → Apps & Credentials) -----------------------
# sandbox while testing; live only after the go-live checklist.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID shown after adding .../functions/v1/paypal-webhook to the same app.
PAYPAL_WEBHOOK_ID=

# --- ECPay 綠界 (merchant back office → 系統開發管理 → 系統介接設定) ------------
# sandbox uses ECPay's public test merchant below; live refuses public test merchants.
ECPAY_ENV=sandbox
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs

# --- Scheduled exchange-rate refresh -------------------------------------------
# At least 24 random characters, e.g. `openssl rand -hex 24`. Same value goes into Vault for pg_cron.
CRON_SECRET=
