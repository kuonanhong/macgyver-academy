      {
       "id": "b237-v15-19",
       "title": "岩體抬動與壓力邊界：試驗與驗證",
       "titleEn": "Rock jacking and pressure boundaries: testing and verification",
       "estimatedMinutes": 25,
       "simulationOnly": true,
       "sourceIds": [
