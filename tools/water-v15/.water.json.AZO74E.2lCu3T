       "id": "b228-v15-29",
       "title": "制動動能與停止距離：機制與系統路徑",
       "titleEn": "Braking energy and stopping distance: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-wallonia-lift",
