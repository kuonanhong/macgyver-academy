      {
       "id": "b230-v15-21",
       "title": "航運代價與關閉頻率：機制與系統路徑",
       "titleEn": "Navigation cost and closure frequency: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "b-src-delta",
        "v15s-delta-adapt",
        "v15s-rws-first",
        "v15s-usace-steel",
        "v15s-usace-mechanical"
       ],
       "prerequisiteIds": [
