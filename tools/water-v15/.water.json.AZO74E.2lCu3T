      {
       "id": "b208-v15-40",
       "title": "獨立量測加權估計：失效診斷",
       "titleEn": "Independent measurement weighted estimate: failure diagnosis",
       "estimatedMinutes": 25,
       "simulationOnly": true,
       "sourceIds": [
