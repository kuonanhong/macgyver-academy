      {
       "id": "b208-v15-37",
       "title": "獨立量測加權估計：機制與系統路徑",
       "titleEn": "Independent measurement weighted estimate: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-baihetan-owner",
        "v15s-baihetan-construction",
        "v15s-usbr-manuals",
