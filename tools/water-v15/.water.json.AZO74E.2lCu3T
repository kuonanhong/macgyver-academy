      {
       "id": "b205-v15-15",
       "title": "轉子不平衡力：試驗與驗證",
       "titleEn": "Rotor unbalance force: testing and verification",
       "estimatedMinutes": 25,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-guri-andritz",
        "v15s-usbr-manuals",
