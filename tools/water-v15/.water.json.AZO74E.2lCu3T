      {
       "id": "b231-v15-03",
       "title": "絕熱溫升與膠結材：試驗與驗證",
       "titleEn": "Adiabatic rise and binder heat: testing and verification",
       "estimatedMinutes": 25,
       "simulationOnly": true,
