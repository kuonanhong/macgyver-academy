      {
       "id": "b208-v15-39",
       "title": "獨立量測加權估計：試驗與驗證",
       "titleEn": "Independent measurement weighted estimate: testing and verification",
       "estimatedMinutes": 25,
       "simulationOnly": true,
       "sourceIds": [
