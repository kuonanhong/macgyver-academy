      {
       "id": "b238-v15-30",
       "title": "廊道開孔的應力集中：定量估算",
       "titleEn": "Gallery opening stress concentration: quantitative estimate",
       "estimatedMinutes": 30,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-usbr-manuals",
        "v15s-usace-gravity",
        "v15s-usbr-joints",
        "b-src-water"
       ],
       "prerequisiteIds": [
