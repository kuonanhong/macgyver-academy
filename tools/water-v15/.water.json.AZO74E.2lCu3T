      {
       "id": "b236-v15-21",
       "title": "層間黏結與剪切：機制與系統路徑",
       "titleEn": "Interlift bond and shear: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-asphalt-quxue",
        "v15s-asphalt-rate",
        "v15s-asphalt-model",
        "v15s-usbr-embankment",
