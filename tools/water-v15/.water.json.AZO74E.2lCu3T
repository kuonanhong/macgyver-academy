      {
       "id": "b215-v15-13",
       "title": "混凝土受拘束溫降：機制與系統路徑",
       "titleEn": "Restrained concrete cooling: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-kurobe-owner",
        "v15s-usace-arch",
        "b-src-water"
