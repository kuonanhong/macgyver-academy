      {
       "id": "b225-v15-21",
       "title": "汽蝕餘裕與吸水：機制與系統路徑",
       "titleEn": "Cavitation margin and suction: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-pub-marina",
        "v15s-pub-marina-faq",
        "v15s-pub-marina-book",
        "v15s-usace-steel",
