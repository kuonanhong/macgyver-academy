      {
       "id": "b239-v15-27",
       "title": "填充層的法向柔度：試驗與驗證",
       "titleEn": "Normal compliance of the filled layer: testing and verification",
       "estimatedMinutes": 25,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-usace-arch-2",
        "v15s-usace-grout",
        "v15s-usbr-manuals",
