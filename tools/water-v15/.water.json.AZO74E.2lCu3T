      {
       "id": "b239-v15-28",
       "title": "填充層的法向柔度：失效診斷",
       "titleEn": "Normal compliance of the filled layer: failure diagnosis",
       "estimatedMinutes": 25,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-usace-arch-2",
