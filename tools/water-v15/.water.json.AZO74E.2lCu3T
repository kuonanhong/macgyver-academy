   "stages": [
    {
     "id": "b227-v15-s1",
     "title": "水文條件、邊界與工程系統",
     "titleEn": "Hydrology, boundaries and engineering system",
     "description": "本階段聚焦「船舶排水與船廂質量」與「配重不平衡功率」：先建立機制、系統路徑與定量模型，再設計試驗驗證並診斷失效。",
     "descriptionEn": "This stage covers \"Vessel displacement and caisson mass\" and \"Counterweight imbalance power\": establish the mechanism, system paths and quantitative model first, then design verification and diagnose failures.",
     "steps": [
      {
       "id": "b227-v15-01",
       "title": "船舶排水與船廂質量：機制與系統路徑",
       "titleEn": "Vessel displacement and caisson mass: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-ctg-trial",
        "v15s-ctg-function",
        "v15s-ctg-history",
        "v15s-usace-steel",
        "v15s-usace-mechanical"
       ],
       "prerequisiteIds": [],
       "objective": "說明「船舶排水與船廂質量」如何影響三峽升船機的受力、變形、水流或訊號表現，並畫出相關輸入、傳遞路徑與邊界。",
       "objectiveEn": "Explain how “Vessel displacement and caisson mass” governs forces, deformation, flow or signals in “Three Gorges ship lift”, and map the relevant inputs, transfer paths and boundaries.",
       "instruction": "浮船進入保持固定水位的船廂時，會排出等重的水，因此船加水總重近似不變。這個平衡依賴船舶自由浮動及水量能夠交換，不能套用坐底或封閉增水情況。 假設船舶質量2000 t、淡水密度1000 kg/m³，排水2000 m³；若維持水位，移出水質量2000 t，理想船廂總質量變化0 t。 船舶坐底後不再完整由浮力支承，水位改變也會破壞固定總重假設。若混淆載貨重量和船舶總排水質量，平衡重判讀將出現大幅偏差。 師傅任務：以自由體圖、流路圖或訊號圖畫出相關物理量如何經過「船舶排水與船廂質量」傳到系統邊界，標出哪些量由設計決定、哪些由材料、施工或環境決定，再用三句話寫出機制摘要。",
       "instructionEn": "A floating vessel entering a fixed-level caisson displaces water of equal weight, keeping vessel-plus-water mass approximately constant. This requires free flotation and water exchange, and does not apply to grounding or added water in a sealed chamber. Assume vessel mass 2000 t and freshwater density 1000 kg/m³. It displaces 2000 m³; maintaining level removes 2000 t of water, giving ideal total mass change zero tonnes. Grounding removes full buoyant support, while changing level breaks constant total mass. Confusing cargo weight with total vessel displacement can cause a large error in interpreting counterweight balance. Mentor task: draw a free-body, flow or signal diagram showing how relevant physical quantities pass through “Vessel displacement and caisson mass” to the system boundary, mark which quantities are fixed by design and which by materials, construction or environment, then summarise the mechanism in three sentences.",
       "observation": "量級提示：教學假設，非地標實測值或操作設定：假設船舶質量2000 t、淡水密度1000 kg/m³，排水2000 m³；若維持水位，移出水質量2000 t，理想船廂總質量變化0 t。",
       "observationEn": "Order-of-magnitude cue: Teaching assumptions, not landmark measurements or operating settings: Assume vessel mass 2000 t and freshwater density 1000 kg/m³.",
       "failure": "常見誤解：「船舶越重，保持水位且自由浮動的船廂總重必定越大。」這個說法忽略了上述機制；請在系統圖上指出它錯在哪一個環節。",
       "failureEn": "Common misconception: \"A heavier freely floating vessel always increases a constant-level caisson total mass.\" It ignores the mechanism above; mark on your system diagram where it breaks down.",
       "check": "系統圖標明「船舶排水與船廂質量」的輸入、傳遞路徑與邊界；三句摘要能解釋本步列出的誤解為何不成立。",
       "checkEn": "The system diagram shows inputs, transfer paths and boundaries for “Vessel displacement and caisson mass”; the three-sentence summary explains why the listed misconception fails.",
       "knowledge": [
        {
         "id": "b227-v15-01-k1",
         "title": "船舶排水與船廂質量",
         "titleEn": "Vessel displacement and caisson mass",
         "text": "浮船進入保持固定水位的船廂時，會排出等重的水，因此船加水總重近似不變。這個平衡依賴船舶自由浮動及水量能夠交換，不能套用坐底或封閉增水情況。",
         "textEn": "A floating vessel entering a fixed-level caisson displaces water of equal weight, keeping vessel-plus-water mass approximately constant. This requires free flotation and water exchange, and does not apply to grounding or added water in a sealed chamber.",
         "sourceIds": [
          "v15s-ctg-trial",
          "v15s-ctg-function",
          "v15s-ctg-history",
          "v15s-usace-steel",
          "v15s-usace-mechanical"
         ]
        },
        {
         "id": "b227-v15-01-k2",
         "title": "誤解辨析",
         "titleEn": "Misconception check",
         "text": "誤解：船舶越重，保持水位且自由浮動的船廂總重必定越大。 正確的工程判斷必須回到傳力機制與量級。",
         "textEn": "Misconception: A heavier freely floating vessel always increases a constant-level caisson total mass. Sound engineering judgement goes back to the load path and magnitude.",
         "sourceIds": [
          "v15s-ctg-trial",
          "v15s-ctg-function",
          "v15s-ctg-history",
          "v15s-usace-steel",
          "v15s-usace-mechanical"
         ]
        }
       ],
       "quiz": {
        "question": "關於「船舶排水與船廂質量」，下列哪一項敘述正確？",
        "questionEn": "Which statement about \"Vessel displacement and caisson mass\" is correct?",
        "options": [
         "船舶越重，保持水位且自由浮動的船廂總重必定越大。",
         "浮船進入保持固定水位的船廂時，會排出等重的水，因此船加水總重近似不變。",
         "有配重就能完全消除所有重力差所需的驅動功率。"
        ],
        "optionsEn": [
         "A heavier freely floating vessel always increases a constant-level caisson total mass.",
         "A floating vessel entering a fixed-level caisson displaces water of equal weight, keeping vessel-plus-water mass approximately constant.",
         "Counterweights completely eliminate drive power required by every gravitational imbalance."
        ],
        "answer": 1,
        "explanation": "浮船進入保持固定水位的船廂時，會排出等重的水，因此船加水總重近似不變。 其餘選項是常見誤解。",
        "explanationEn": "A floating vessel entering a fixed-level caisson displaces water of equal weight, keeping vessel-plus-water mass approximately constant. The other options are common misconceptions."
       },
       "unit": 1,
