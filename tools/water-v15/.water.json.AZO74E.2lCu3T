      {
       "id": "b203-v15-29",
       "title": "停機容量與水量：機制與系統路徑",
       "titleEn": "Outage capacity and water allocation: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
