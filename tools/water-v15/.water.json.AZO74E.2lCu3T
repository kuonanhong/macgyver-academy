      {
       "id": "b208-v15-03",
       "title": "柱狀節理串聯柔度：試驗與驗證",
       "titleEn": "Columnar joint series compliance: testing and verification",
       "estimatedMinutes": 25,
       "simulationOnly": true,
       "sourceIds": [
