      {
       "id": "b239-v15-30",
       "title": "封拱後的荷載分配：定量估算",
       "titleEn": "Load sharing after closure: quantitative estimate",
       "estimatedMinutes": 30,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-usace-arch-2",
        "v15s-usace-grout",
