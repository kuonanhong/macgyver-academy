      {
       "id": "b215-v15-05",
       "title": "理想拱圈膜壓應力：機制與系統路徑",
       "titleEn": "Ideal arch membrane compression: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-kurobe-owner",
        "v15s-usace-arch",
        "b-src-water"
       ],
       "prerequisiteIds": [
