       "id": "b227-v15-05",
       "title": "配重不平衡功率：機制與系統路徑",
       "titleEn": "Counterweight imbalance power: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-ctg-trial",
        "v15s-ctg-function",
        "v15s-ctg-history",
        "v15s-usace-steel",
