      {
       "id": "b214-v15-37",
       "title": "高落差輸水與淨能量：機制與系統路徑",
       "titleEn": "High-head conveyance and net energy: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "b-src-water-manuals",
        "v15s-grande-dixence-owner",
        "v15s-grande-dixence-history",
        "v15s-usbr-monitoring",
