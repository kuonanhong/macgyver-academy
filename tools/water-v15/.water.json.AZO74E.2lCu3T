      {
       "id": "b209-v15-20",
       "title": "軸承油熱容量：失效診斷",
       "titleEn": "Bearing oil thermal storage: failure diagnosis",
       "estimatedMinutes": 25,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-xiluodu-voith",
        "v15s-usbr-manuals",
