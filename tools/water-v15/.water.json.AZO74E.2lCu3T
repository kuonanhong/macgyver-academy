      {
       "id": "b209-v15-13",
       "title": "定子銅損邊界：機制與系統路徑",
       "titleEn": "Stator copper loss boundary: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-xiluodu-voith",
        "v15s-usbr-manuals",
