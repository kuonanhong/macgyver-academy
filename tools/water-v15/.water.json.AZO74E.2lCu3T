      {
       "id": "b240-v15-38",
       "title": "導流切換與關鍵工期：定量估算",
       "titleEn": "Diversion transitions and critical duration: quantitative estimate",
       "estimatedMinutes": 30,
       "simulationOnly": true,
       "sourceIds": [
