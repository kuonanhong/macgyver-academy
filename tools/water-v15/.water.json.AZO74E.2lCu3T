       "id": "b216-v15-13",
       "title": "岩盤層面有效正向力：機制與系統路徑",
       "titleEn": "Effective force on rock bedding: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
