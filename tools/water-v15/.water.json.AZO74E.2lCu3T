      {
       "id": "b232-v15-31",
       "title": "上下游面層協調：試驗與驗證",
       "titleEn": "Facing and RCC compatibility: testing and verification",
       "estimatedMinutes": 25,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-usace-rcc",
        "v15s-usace-gravity",
        "v15s-usbr-manuals"
       ],
       "prerequisiteIds": [
