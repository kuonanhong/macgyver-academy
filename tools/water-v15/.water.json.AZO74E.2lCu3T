     "descriptionEn": "This stage covers \"Bearing oil thermal storage\" and \"Valley closure reference geometry\": establish the mechanism, system paths and quantitative model first, then design verification and diagnose failures.",
     "steps": [
      {
       "id": "b209-v15-17",
       "title": "軸承油熱容量：機制與系統路徑",
       "titleEn": "Bearing oil thermal storage: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
