      {
       "id": "b213-v15-21",
       "title": "機組出力與水頭：機制與系統路徑",
       "titleEn": "Generating output and hydraulic head: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "b-src-water-manuals",
        "v15s-vra-akosombo",
        "v15s-usbr-filters",
        "v15s-hoover-owner"
       ],
       "prerequisiteIds": [
