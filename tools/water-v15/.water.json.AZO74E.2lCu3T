      {
       "id": "b202-v15-05",
       "title": "裂縫連通與揚壓：機制與系統路徑",
       "titleEn": "Crack connectivity and uplift: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
