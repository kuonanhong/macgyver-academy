     "descriptionEn": "This stage covers \"Nominal residence and water age\" and \"Hydrostatic horizontal projected force\": establish the mechanism, system paths and quantitative model first, then design verification and diagnose failures.",
     "steps": [
      {
       "id": "b216-v15-01",
       "title": "名目停留時間與水齡：機制與系統路徑",
       "titleEn": "Nominal residence and water age: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
