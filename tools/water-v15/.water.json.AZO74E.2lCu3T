      {
       "id": "b239-v15-31",
       "title": "封拱後的荷載分配：試驗與驗證",
       "titleEn": "Load sharing after closure: testing and verification",
       "estimatedMinutes": 25,
       "simulationOnly": true,
       "sourceIds": [
