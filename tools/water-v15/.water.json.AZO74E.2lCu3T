     "descriptionEn": "This stage covers \"Fracture aperture and flow\" and \"Ventilation local resistance\": establish the mechanism, system paths and quantitative model first, then design verification and diagnose failures.",
     "steps": [
      {
       "id": "b209-v15-25",
       "title": "裂隙開度與滲流：機制與系統路徑",
       "titleEn": "Fracture aperture and flow: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
