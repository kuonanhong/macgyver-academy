      {
       "id": "b240-v15-03",
       "title": "施工期洪水暴露：試驗與驗證",
       "titleEn": "Construction-period flood exposure: testing and verification",
       "estimatedMinutes": 25,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-usace-coffer",
