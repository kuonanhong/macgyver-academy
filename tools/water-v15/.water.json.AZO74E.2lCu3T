     "descriptionEn": "This stage covers \"Hydration heat and restraint\" and \"Curtain testing and permeability\": establish the mechanism, system paths and quantitative model first, then design verification and diagnose failures.",
     "steps": [
      {
       "id": "b214-v15-25",
       "title": "水化熱與拘束：機制與系統路徑",
       "titleEn": "Hydration heat and restraint: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "b-src-water-manuals",
        "v15s-grande-dixence-owner",
