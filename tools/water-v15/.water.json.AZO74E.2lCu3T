       "title": "成熟度與強度校正：機制與系統路徑",
       "titleEn": "Maturity and strength calibration: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-usace-gravity",
        "v15s-usbr-manuals",
        "v15s-usace-rcc"
