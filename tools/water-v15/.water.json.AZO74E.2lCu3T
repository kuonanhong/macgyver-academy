      {
       "id": "three-gorges-v15-05",
       "title": "分段庫容積分：機制與系統路徑",
       "titleEn": "Piecewise storage integration: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "v5-place-c445157198d7",
        "v15s-usbr-manuals",
