     "descriptionEn": "This stage covers \"Rockfill wetting and settlement\" and \"Synthetic core stress transfer\": establish the mechanism, system paths and quantitative model first, then design verification and diagnose failures.",
     "steps": [
      {
       "id": "b213-v15-01",
       "title": "堆石濕陷與水位：機制與系統路徑",
       "titleEn": "Rockfill wetting and settlement: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
