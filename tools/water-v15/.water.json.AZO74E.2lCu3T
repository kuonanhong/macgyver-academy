       "id": "b212-v15-37",
       "title": "修復效益與同工況：機制與系統路徑",
       "titleEn": "Rehabilitation benefit and matched states: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "b-src-water-manuals",
        "v15s-zra-history",
