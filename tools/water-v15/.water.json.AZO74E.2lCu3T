      {
       "id": "b223-v15-29",
       "title": "波浪脈衝與反力：機制與系統路徑",
       "titleEn": "Wave impulse and reaction: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-ea-thames",
        "v15s-ea-thames40",
        "v15s-archives-thames",
        "v15s-usace-steel",
