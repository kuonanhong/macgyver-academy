      {
       "id": "b215-v15-10",
       "title": "岩盤順應與推力位移：定量估算",
       "titleEn": "Abutment compliance under thrust: quantitative estimate",
       "estimatedMinutes": 30,
       "simulationOnly": true,
       "sourceIds": [
