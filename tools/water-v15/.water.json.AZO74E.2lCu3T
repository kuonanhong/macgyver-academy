      {
       "id": "b205-v15-04",
       "title": "效率試驗不確定度：失效診斷",
       "titleEn": "Efficiency test uncertainty: failure diagnosis",
       "estimatedMinutes": 25,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-guri-andritz",
        "v15s-usbr-manuals",
        "v15s-usbr-instruments"
