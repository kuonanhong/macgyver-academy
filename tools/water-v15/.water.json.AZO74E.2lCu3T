       "simulationOnly": true,
       "sourceIds": [
        "v15s-xiaowan-huaneng",
        "v15s-usbr-manuals",
        "v15s-usbr-instruments"
       ],
       "prerequisiteIds": [
        "b206-v15-27"
       ],
       "objective": "從症狀倒推「季節調蓄水量」的失效或劣化原因，提出能區分原因的檢查、矯正與預防措施。",
       "objectiveEn": "Work back from symptoms to the failure or deterioration causes of “Seasonal storage water balance” and propose discriminating checks, corrective actions and prevention.",
       "instruction": "將月平均餘水全部當成可儲水量，會忽略洪水期間空間已滿的可能；水庫面積隨水位增加又使蒸發量變動，固定損失比例未必適合整季。 師傅任務：建立失效樹——症狀、兩個以上可能原因、能區分它們的量測或檢測，以及矯正與預防措施；並說明此失效如何影響整體結構的安全、使用性、耐久或營運。",
       "instructionEn": "Treating all average surplus as storable ignores periods when flood storage is already full. Changing surface area also changes evaporation, so a fixed loss fraction may be inappropriate across an entire storage season. Mentor task: build a fault tree with the symptom, at least two candidate causes, a measurement or inspection that tells them apart, and corrective and preventive actions; explain how the failure affects whole-structure safety, serviceability, durability or operation.",
       "observation": "連結機制：入出流平均值的採樣方法應一致，不等間隔觀測需要時間加權，否則算術平均可能偏向密集觀測的洪峰時段。",
       "observationEn": "Link to the mechanism: Inflow and outflow averaging must be consistent; irregular observations require time weights or an arithmetic mean can overrepresent flood peaks sampled more densely than other periods.",
       "failure": "誤判風險：若相信「月底水量平衡就保證月內沒有庫容限制」，上述症狀可能被錯誤處理而反覆出現。",
       "failureEn": "Misdiagnosis risk: believing \"A month-end water balance guarantees no capacity constraint within the month.\" leads to mishandling the symptom so it keeps returning.",
       "check": "完成失效樹與矯正措施，指出哪一項量測或檢測能最快確認根因、需要哪些人簽認，以及如何防止再發。",
       "checkEn": "Complete the fault tree and corrective actions, name the measurement or inspection that confirms the root cause fastest, who must sign off, and how recurrence is prevented.",
       "knowledge": [
        {
         "id": "b206-v15-28-k1",
         "title": "失效模式",
         "titleEn": "Failure mode",
         "text": "將月平均餘水全部當成可儲水量，會忽略洪水期間空間已滿的可能；水庫面積隨水位增加又使蒸發量變動，固定損失比例未必適合整季。",
         "textEn": "Treating all average surplus as storable ignores periods when flood storage is already full. Changing surface area also changes evaporation, so a fixed loss fraction may be inappropriate across an entire storage season.",
         "sourceIds": [
          "v15s-xiaowan-huaneng",
          "v15s-usbr-manuals",
          "v15s-usbr-instruments"
         ]
        },
        {
         "id": "b206-v15-28-k2",
         "title": "根因確認",
         "titleEn": "Root-cause confirmation",
         "text": "根因必須以可區分的量測或檢測確認；只補強外觀、更換構件或放寬允收值可能掩蓋問題。",
         "textEn": "Confirm the root cause with a discriminating measurement or inspection; cosmetic repair, swapping components or relaxing limits can mask the problem.",
         "sourceIds": [
          "v15s-xiaowan-huaneng",
          "v15s-usbr-manuals",
          "v15s-usbr-instruments"
         ]
        }
