      {
       "id": "b202-v15-13",
       "title": "接縫閉合與溫度：機制與系統路徑",
       "titleEn": "Joint closure and temperature: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "v6-hoover-dam",
        "v15s-usbr-manuals",
        "v15s-usbr-instruments",
        "v15s-usace-catalog"
       ],
       "prerequisiteIds": [
