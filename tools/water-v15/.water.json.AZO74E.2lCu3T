      {
       "id": "b238-v15-05",
       "title": "揚壓分布與合力：機制與系統路徑",
       "titleEn": "Uplift distribution and resultant: mechanism and system paths",
       "estimatedMinutes": 20,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-usbr-manuals",
        "v15s-usace-gravity",
        "v15s-usbr-joints",
        "b-src-water"
       ],
       "prerequisiteIds": [
