      {
       "id": "b233-v15-23",
       "title": "岩體柔度與拱座位移：試驗與驗證",
       "titleEn": "Rock compliance and abutment movement: testing and verification",
       "estimatedMinutes": 25,
       "simulationOnly": true,
       "sourceIds": [
        "v15s-usace-arch-2",
        "b-src-water-manuals",
