      {
       "id": "b233-v15-30",
       "title": "網格收斂與局部奇異：定量估算",
       "titleEn": "Mesh convergence and singularity: quantitative estimate",
       "estimatedMinutes": 30,
       "simulationOnly": true,
       "sourceIds": [
