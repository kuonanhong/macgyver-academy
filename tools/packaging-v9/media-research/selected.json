2", "extmetadata": {"DateTime": {"value": "2022-05-06 12:34:59", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "CMI 300301", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "Power MOSFET|Self-published work|Photos by User:Mister rf", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "CMI 300301: 3-Phase Bridge MOSFET Power Module.\n<p>Six power transistors in a three-phase  bridge configuration. The CMI300301 is a replacement for the MPM3003 with only minor differences in mechanical specifications. \n</p>\nContinuous drain current\u00a0: 10A, Pulsed drain current:  25A, Drain to Source voltage: 60V.  This device interfaces directly with most brushless motor drive IC\u2019s without special gate driving requirements since it contains P-Channel MOSFETs for the top transistors and N-Channel MOSFETs for the bottom transistors.", "source": "commons-desc-page"}, "DateTimeOriginal": {"value": "2022-05-03 11:35:48", "source": "commons-desc-page"}, "Credit": {"value": "<span class=\"int-own-work\" lang=\"en\">Own work</span>", "source": "commons-desc-page"}, "Artist": {"value": "<a href=\"//commons.wikimedia.org/wiki/User:Mister_rf\" title=\"User:Mister rf\">Mister rf</a>", "source": "commons-desc-page"}, "LicenseShortName": {"value": "CC BY-SA 4.0", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "Creative Commons Attribution-Share Alike 4.0", "source": "commons-desc-page"}, "AttributionRequired": {"value": "true", "source": "commons-desc-page", "hidden": ""}, "LicenseUrl": {"value": "https://creativecommons.org/licenses/by-sa/4.0", "source": "commons-desc-page"}, "Copyrighted": {"value": "True", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}, "License": {"value": "cc-by-sa-4.0", "source": "commons-templates", "hidden": ""}}}]}, "132529469": {"pageid": 132529469, "ns": 6, "title": "File:FMN Lab electro-optical integrated modulator.jpg", "imagerepository": "local", "imageinfo": [{"size": 1898889, "width": 3812, "height": 2722, "thumburl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f6/FMN_Lab_electro-optical_integrated_modulator.jpg/960px-FMN_Lab_electro-optical_integrated_modulator.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "thumbwidth": 960, "thumbheight": 685, "responsiveUrls": {"2": "https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f6/FMN_Lab_electro-optical_integrated_modulator.jpg/1920px-FMN_Lab_electro-optical_integrated_modulator.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"}, "thumbattribs": {"src": "https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f6/FMN_Lab_electro-optical_integrated_modulator.jpg/960px-FMN_Lab_electro-optical_integrated_modulator.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "decoding": "async", "loading": "lazy", "width": 960, "height": 685, "srcset": "https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f6/FMN_Lab_electro-optical_integrated_modulator.jpg/1920px-FMN_Lab_electro-optical_integrated_modulator.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"}, "url": "https://upload.wikimedia.org/wikipedia/commons/f/f6/FMN_Lab_electro-optical_integrated_modulator.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "descriptionurl": "https://commons.wikimedia.org/wiki/File:FMN_Lab_electro-optical_integrated_modulator.jpg", "descriptionshorturl": "https://commons.wikimedia.org/w/index.php?curid=132529469", "sha1": "f216ecf0d0fbbca6952b708dc097f24f6a6a15eb", "extmetadata": {"DateTime": {"value": "2023-05-31 20:44:15", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "FMN Lab electro-optical integrated modulator", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "Photonics|Self-published work|Images from Wiki Science Competition 2023 in Russia|Files with coordinates missing SDC location of creation|General category images from Russian Science Photo Competition 2023|Uploaded via Campaign:wsc23-ru", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "GPSLatitude": {"value": "55.771000", "source": "commons-desc-page"}, "GPSLongitude": {"value": "37.691917", "source": "commons-desc-page"}, "GPSMapDatum": {"value": "WGS-84", "source": "commons-desc-page", "hidden": ""}, "ImageDescription": {"value": "The photoshoot is demonstrating a chip of an electro-optical integrated modulator in the process of wire bonding of electrical contacts. Electro-optical modulation devices are multilayer structures of nanometer-thick materials. They are used as interconnects for data centers for the Internet, in optical transmitters, LiDAR systems, quantum and neuromorphic photonic computing. The presented modulator can achieve speeds up to tens of GHz and low losses of the signal. Designed, simulated and fabricated at FMN Laboratory.", "source": "commons-desc-page"}, "DateTimeOriginal": {"value": "2023-03-31", "source": "commons-desc-page"}, "Credit": {"value": "<span class=\"int-own-work\" lang=\"en\">Own work</span>", "source": "commons-desc-page"}, "Artist": {"value": "<a href=\"//commons.wikimedia.org/w/index.php?title=User:FMNLab&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"User:FMNLab (page does not exist)\">FMNLab</a>", "source": "commons-desc-page"}, "LicenseShortName": {"value": "CC BY 4.0", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "Creative Commons Attribution 4.0", "source": "commons-desc-page"}, "AttributionRequired": {"value": "true", "source": "commons-desc-pa